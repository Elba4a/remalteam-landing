{
  "name": "remalteam-landing",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Directory indexes are canonical with a trailing slash (/units/index.html → /units/).
    // The asset runtime redirects the other spelling with 307; worker.js turns that into 301.
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  // Free Workers Analytics Engine. One point per /wa/* redirect.
  // Dataset is created on the first write after deploy. Not created by this config alone.
  "analytics_engine_datasets": [
    {
      "binding": "WA_CLICKS",
      "dataset": "remal_wa_clicks"
    }
  ],
  "routes": [
    { "pattern": "remalteam.com", "custom_domain": true },
    { "pattern": "www.remalteam.com", "custom_domain": true }
  ],
  "workers_dev": false
}
