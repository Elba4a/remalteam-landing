{
  "name": "remalteam-landing",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "remalteam.com", "custom_domain": true },
    { "pattern": "www.remalteam.com", "custom_domain": true }
  ],
  "workers_dev": false
}
